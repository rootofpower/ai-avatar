# Required
GEMINI_API_KEY=your_gemini_api_key

# Knowledge base (optional — Gemini answers directly if unreachable)
TUNA_API_URL=http://localhost:11136

# MQTT broker delivering recognized speech
MQTT_BROKER=localhost
MQTT_PORT=1883

# Avatar pipeline (needs an NVIDIA GPU)
AVATAR_ENABLED=false
AVATAR_IMAGE=
AVATAR_IDLE_VIDEO=
AVATAR_THINKING_VIDEO=
AVATAR_TALKING_VIDEO=
WEBRTC_PORT=8080

# Fine-tuning
AVATAR_TALKING_SPEED=0.75
AVATAR_FLUSH_SILENCE_MS=1500
AVATAR_VOICE_FILTER_ENABLED=true
AVATAR_VOICE_FILTER_PITCH=1.20
